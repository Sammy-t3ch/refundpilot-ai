# ==============================================================
# RefundPilot AI — Environment Configuration
# ==============================================================

# Google Gemini API Key (Server-Side Only)
# If left blank, the application automatically activates Fallback AI mode.
# Never expose this key in client-side code or commit it to version control.
GEMINI_API_KEY=

# Gemini Model alias (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL Database Connection String (used in Docker Compose / Production)
DATABASE_URL=postgresql://refundpilot:refundpilot@postgres:5432/refundpilot

# Backend Server Port (4000 in Docker standalone mode, 3000 in dev fullstack)
PORT=4000

# Client origin for CORS authorization
FRONTEND_URL=http://localhost:3000

# Node Environment ('development' or 'production')
NODE_ENV=development
